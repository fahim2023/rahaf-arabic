# Copy to .env for local development. Never commit the real .env.
DEBUG=True
SECRET_KEY=change-me
# Leave out to use SQLite locally. Example for local Postgres:
# DATABASE_URL=postgres://postgres:password@localhost:5432/rahaf
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://www.example.com
SITE_URL=http://localhost:8000

# Where booking and question alerts go
TEACHER_EMAIL=rahaf@example.com

# Email. Locally, emails print in the terminal. For Gmail use an app password.
